{
  "name": "japan-flags-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/aluqas/japan-flags",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:precomposed-svg": "vite --config experiments/precomposed-svg/vite.config.ts",
    "build": "vite build",
    "build:precomposed-svg": "vite build --config experiments/precomposed-svg/vite.config.ts",
    "preview": "vite preview",
    "render:maps": "deno run -A scripts/render-maps.ts",
    "render:install-browser": "deno run -A npm:playwright install chromium",
    "deploy:validate": "deno run -A scripts/validate-cloudflare-deploy.ts",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:deploy:dry-run": "wrangler deploy --dry-run",
    "typecheck": "tsc -b && tsc --project experiments/precomposed-svg/tsconfig.json",
    "typecheck:precomposed-svg": "tsc --project experiments/precomposed-svg/tsconfig.json",
    "build:flag-sprites": "deno run -A scripts/build-flag-sprites.mjs",
    "build:flag-sprites:full-only": "deno run -A scripts/build-flag-sprites.mjs --recheck-full-only",
    "validate:generated-data": "deno run -A scripts/validate-generated-data.mjs",
    "report:render-assets": "deno run -A scripts/report-render-assets.mjs",
    "test": "vitest run",
    "lint": "oxlint --react-plugin --vitest-plugin --import-plugin --jsx-a11y-plugin src scripts experiments/precomposed-svg vite.config.ts",
    "format": "oxfmt src scripts experiments/precomposed-svg vite.config.ts wrangler.jsonc package.json deno.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check src scripts experiments/precomposed-svg vite.config.ts wrangler.jsonc package.json deno.json .oxlintrc.json .oxfmtrc.json"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-geo": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^27.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "playwright": "^1.61.1",
    "saxes": "^6.0.0",
    "sharp": "^0.35.3",
    "svgo": "^4.0.2",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.102.0"
  }
}
